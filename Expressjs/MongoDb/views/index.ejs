<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>College users</h1>


    <div class="content">

        <% users.forEach(user=>{%>
            <h3><strong>name</strong><%= user.name %></h3>
            <h4> <strong>age</strong><%= user.age%></h4>
            <h4> <strong>city</strong><%= user.city%></h4>
            <% }) %>
    </div>
</body>
</html>