<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dynamic Routing</title>
</head>

<body>
    <h1>List of Users</h1>

    <ul>
        <% users.forEach(user => { %>
            <li>
                <a href="/users/<%= user._id %>"><%= user.name %></a>
            </li>
        <% }) %>
    </ul>
    <a href="/users/all">View all users data</a>

</body>

</html>